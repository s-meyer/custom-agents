# Copy to shared/.env and fill in. Keep shared/.env untracked and private.

# --- Runtime -------------------------------------------------------------------
# run (one task from stdin), serve (HTTP on PORT), or smoke (credential check).
AGENT_MODE=run

# --- Logging -------------------------------------------------------------------
# human (concise terminal progress) or json (one JSON object per line).
LOG_FORMAT=human
# DEBUG also logs each Codex command's exit code and duration.
# LOG_LEVEL=INFO
# Azure SDK HTTP request/response dumps are hidden below WARNING; set INFO to
# debug Entra authentication.
# LOG_LEVEL_AZURE=WARNING

# --- Provider credentials --------------------------------------------------------
# Optional: API billing instead of ChatGPT/Codex plan authentication.
# OPENAI_API_KEY=
# Required only for the Claude Agent SDK container (Anthropic API billing).
# ANTHROPIC_API_KEY=
# Required only for OpenCode (Anthropic API billing).

# --- Azure service principal (used by the gateway and Foundry options below) ------
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# --- Azure OpenAI-compatible gateway (e.g. APIM) with Entra auth -----------------
# Used by Codex when AZURE_BASE_URL is set and AZURE_AUTH=entra; takes precedence
# over AI_PROVIDER=azure-foundry. The task contract's "model" field must be a model
# the gateway exposes, and the gateway must serve the Responses API.
# AZURE_BASE_URL=https://<gateway>.azure-api.net/openai/v1
# AZURE_AUTH=entra
# AZURE_ENTRA_SCOPE=api://<gateway-app>/.default

# --- Azure AI Foundry ----------------------------------------------------------
# Select "azure-foundry" to use the service principal in every SDK container.
# Leave unset to use the provider-specific credentials above.
# AI_PROVIDER=azure-foundry
# Azure AI Foundry resource endpoint, e.g. https://my-resource.services.ai.azure.com
# AZURE_AI_FOUNDRY_ENDPOINT=
# The task contract's required "model" field selects the deployment.
# OpenCode API shape: "anthropic" for Claude deployments, "openai" for OpenAI-compatible models.
# AZURE_AI_FOUNDRY_API=openai
# Entra ID OAuth scope. Most Foundry resource endpoints use this scope.
# AZURE_AI_FOUNDRY_TOKEN_SCOPE=https://ai.azure.com/.default

# --- Codex -----------------------------------------------------------------------
# Ask Codex for reasoning summaries ("Codex thinking: ..."): auto, concise or detailed.
# Leave unset if the model or gateway rejects the reasoning.summary parameter.
# CODEX_REASONING_SUMMARY=concise
# The Codex image sets "container": Codex's own bwrap sandbox cannot run under
# Docker, so commands run unsandboxed inside the non-root container and approvals
# are never requested (contract read_only is then not enforced for shell commands).
# Set empty to map the contract sandbox to Codex's sandbox modes instead.
# CODEX_SANDBOX_BOUNDARY=container
