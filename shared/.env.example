AGENT_MODE=run
LOG_FORMAT=human
# Optional: API billing instead of ChatGPT/Codex plan authentication.
# OPENAI_API_KEY=
# Required only for the Claude Agent SDK container (Anthropic API billing).
# ANTHROPIC_API_KEY=
# Required only for OpenCode (Anthropic API billing).

# Select "azure-foundry" to use the service principal below in every SDK container.
# Leave unset to use the provider-specific credentials above.
# AI_PROVIDER=azure-foundry
# Azure AI Foundry resource endpoint, e.g. https://my-resource.services.ai.azure.com
# AZURE_AI_FOUNDRY_ENDPOINT=
# The task contract's required "model" field selects the deployment.
# OpenCode API shape: "anthropic" for Claude deployments, "openai" for OpenAI-compatible models.
# AZURE_AI_FOUNDRY_API=openai
# Entra ID OAuth scope. Most Foundry resource endpoints use this scope.
# AZURE_AI_FOUNDRY_TOKEN_SCOPE=https://ai.azure.com/.default
# Service principal credentials. Keep this file untracked and private.
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# Azure OpenAI-compatible gateway (e.g. APIM) with Entra auth. Used by Codex; takes
# precedence over AI_PROVIDER=azure-foundry. Also needs the service principal above.
# AZURE_BASE_URL=https://<gateway>.azure-api.net/openai/v1
# AZURE_AUTH=entra
# AZURE_ENTRA_SCOPE=api://<gateway-app>/.default

# Logging detail. LOG_LEVEL=DEBUG also logs each command's exit code and duration.
# LOG_LEVEL=INFO
# Ask Codex for reasoning summaries ("Codex thinking: ..."): auto, concise or detailed.
# Leave unset if the model or gateway rejects the reasoning.summary parameter.
# CODEX_REASONING_SUMMARY=concise
